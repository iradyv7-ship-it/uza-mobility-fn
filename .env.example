# uza-mobility-fn — customer platform (Next.js)
# Every variable this app reads. Nothing else is consulted.
# See 04-uza-cloud/deploy-env.md in the guide repository for the cross-project rules.

NODE_ENV=production

# This app's own public address. Used for redirects, the sitemap and metadata.
# Must EXACTLY match FRONTEND_URL on the API, and its origin must appear in the API's CORS_ORIGINS.
NEXT_PUBLIC_APP_URL=https://uzamobility.com

# The API's public address. No trailing slash. Baked into the browser bundle at build time —
# a change requires a rebuild, not just a restart.
NEXT_PUBLIC_API_URL=https://api.uzamobility.com

# Auth.js session-cookie signing secret. Generate: openssl rand -base64 48
# Different from the API's JWT_SECRET and from the admin app's AUTH_SECRET.
AUTH_SECRET=

# Optional. Extra https hosts next/image may load from, comma-separated (e.g. a CDN or the
# API's upload host if it differs from NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=
